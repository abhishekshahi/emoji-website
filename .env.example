# Public production URL baked into canonicals, sitemap, robots, OG, Twitter, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://emojiquick.com

# Master R2 data layer: OFF | DATA_READY | ENABLED (default OFF — no production dependency)
MASTER_R2_MODE=OFF

# Public master platform: OFF | LOCAL | ENABLED (default OFF in production; LOCAL in development)
PUBLIC_MASTER_PLATFORM_MODE=OFF
