# Public production URL baked into canonicals, sitemap, robots, OG, Twitter, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://emojiquick.com

# Master R2 data layer: OFF | DATA_READY | ENABLED (default OFF — no production dependency)
MASTER_R2_MODE=OFF

# Public master platform: OFF | LOCAL | ENABLED (default OFF in production; LOCAL in development)
PUBLIC_MASTER_PLATFORM_MODE=OFF

# SEO rollout gate: OFF | CANARY | FULL (production value set in wrangler.jsonc)
# MASTER_SEO_ROLLOUT_MODE=OFF

# --- Cloudflare local dev (.dev.vars) ---
# Copy this file to .dev.vars for wrangler dev / opennextjs-cloudflare preview.
# Production values are set in wrangler.jsonc → vars, not here.

# Local dev shim (set automatically by opennextjs-cloudflare preview)
# NEXTJS_ENV=development

# QA probe bypass for protected preview deployments (optional, audit scripts only)
# SEO_QA_PROTECTION_BYPASS=

# Cloudflare Workers preview URL (optional, for audit scripts)
# SEO_QA_OFF_BASE_URL=https://emoji-website.emoji-website.workers.dev
