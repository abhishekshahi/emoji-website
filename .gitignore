# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.open-next/

# local R2 export artifacts (generated by npm run r2:prepare)
.r2-export/

# complete master archive export (generated by npm run r2:prepare-full)
.r2-export-full/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example
# Large raw emoji data — keep locally, don't commit
/src/data/master/raw/artwork/
/src/data/master/raw/vendor/
# Logs
*.log
