{
  "name": "emoji-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "data:build": "tsx scripts/build-emoji-data.ts",
    "extras:build": "tsx scripts/build-openmoji-extras.ts",
    "artwork:import": "tsx scripts/import-openmoji-assets.ts",
    "extras:import": "tsx scripts/import-openmoji-extras-assets.ts",
    "prebuild": "npm run artwork:import && npm run extras:import"
  },
  "dependencies": {
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "next": "16.3.0",
    "openmoji": "^17.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
